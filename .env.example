# PetCheck browser and calendar settings
PETCHECK_CALENDAR_TIMEZONE=America/Los_Angeles
PETCHECK_CALENDAR_CALENDAR_NAME=PetCheck Calendar
PETCHECK_CALENDAR_EVENT_SUMMARY=Pet service
PETCHECK_CALENDAR_DEFAULT_DURATION_MINUTES=30
PETCHECK_CALENDAR_DETAIL_CACHE_HOURS=24
PETCHECK_CALENDAR_DAYS_AHEAD=31
PETCHECK_CALENDAR_REFRESH_MINUTES=60

# PetCheck credentials used to renew an expired browser session automatically.
PETCHECK_CALENDAR_USERNAME=
PETCHECK_CALENDAR_PASSWORD=

# The default service is intentionally reachable only from this computer.
PETCHECK_CALENDAR_HOST=127.0.0.1
PETCHECK_CALENDAR_PORT=8765

# Optional. A private token is generated in data/feed-token when left blank.
PETCHECK_CALENDAR_FEED_TOKEN=

# Set these only if automatic calendar discovery does not match PetCheck's UI.
# PETCHECK_CALENDAR_DASHBOARD_URL=https://dashboard.petchecktechnology.com/
# PETCHECK_CALENDAR_CALENDAR_URL=
# PETCHECK_CALENDAR_EVENT_SELECTOR=.calendar_item
